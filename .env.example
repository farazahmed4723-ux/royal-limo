# Royal 12 Limo - Environment Configuration Template

# Site URL for canonical and metadata generation
NEXT_PUBLIC_SITE_URL=https://royal12.ca

# Google Maps Platform (Browser & Server)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_restricted_browser_google_maps_api_key_here
GOOGLE_MAPS_SERVER_KEY=your_secure_server_google_maps_key_here

# Stripe Payment Gateway
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_key

# PayPal Checkout
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_secret_here

# Interac e-Transfer Configuration
INTERAC_RECIPIENT_EMAIL=royaltwelve.ca@gmail.com

# PostgreSQL & Prisma Database
DATABASE_URL="postgresql://user:password@localhost:5432/royal12_db?schema=public"

# Admin Authentication
ADMIN_SECRET_KEY=your_secure_admin_jwt_secret_here
